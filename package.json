{
  "name": "personal-website",
  "license": "UNLICENSED",
  "description": "Personal website",
  "keywords": [
    "Next.js",
    "TypeScript",
    "MDX",
    "Sanity CMS",
    "Design Systems",
    "Portfolio"
  ],
  "homepage": "https://eduardstefan.dev",
  "bugs": {
    "url": "https://github.com/edustef/personal-website/issues"
  },
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm-run-all --parallel --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "build:next": "npm run build --workspace=frontend",
    "serve:next": "npm run start --workspace=frontend",
    "deploy:next": "npm run deploy --workspace=frontend",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "type-check": "npm run type-check --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "npm-run-all2": "^8.0.4"
  }
}
